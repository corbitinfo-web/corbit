<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="100%" height="100%">
  <defs>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="10" flood-color="rgba(0,0,0,0.7)"/>
    </filter>
    <linearGradient id="g_Orbit Rig" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e6a1aa"/>
      <stop offset="100%" stop-color="#2e1b1f"/>
    </linearGradient>
  </defs>
  <g filter="url(#shadow)">
    <circle cx="160" cy="160" r="110" fill="none" stroke="#e6a1aa" stroke-width="2" stroke-dasharray="6,4"/>
    <circle cx="160" cy="160" r="95" fill="#1c1214" stroke="#5c333b" stroke-width="1.5"/>
    <polygon points="160,80 230,200 90,200" fill="none" stroke="#e6a1aa" stroke-width="2"/>
    <circle cx="160" cy="160" r="30" fill="url(#g_Orbit Rig)" opacity="0.85"/>
    <text x="160" y="250" text-anchor="middle" fill="#e6a1aa" font-family="system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2">ORBIT RIG</text>
  </g>
</svg>