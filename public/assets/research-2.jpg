<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg_RESEARCH_02" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a1813"/>
      <stop offset="60%" stop-color="#2d281e"/>
      <stop offset="100%" stop-color="#1a1813"/>
    </linearGradient>
    <radialGradient id="vignette_RESEARCH_02" cx="50%" cy="50%" r="60%">
      <stop offset="50%" stop-color="transparent"/>
      <stop offset="100%" stop-color="rgba(0,0,0,0.6)"/>
    </radialGradient>
    <pattern id="grid_RESEARCH_02" width="20" height="20" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="20" y2="0" stroke="#5c5038" stroke-width="0.5" opacity="0.3"/>
      <line x1="0" y1="0" x2="0" y2="20" stroke="#5c5038" stroke-width="0.5" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg_RESEARCH_02)"/>
  <rect width="100%" height="100%" fill="url(#grid_RESEARCH_02)"/>
  <rect width="100%" height="100%" fill="url(#vignette_RESEARCH_02)"/>
  
  <!-- Subtle Framing -->
  <rect x="14" y="14" width="372" height="272" fill="none" stroke="#5c5038" stroke-width="1" opacity="0.6"/>
  <rect x="18" y="18" width="364" height="264" fill="none" stroke="#e8d8ab" stroke-width="0.5" opacity="0.3"/>

  <!-- Decorative Corner Marks -->
  <path d="M 14 26 L 14 14 L 26 14" fill="none" stroke="#e8d8ab" stroke-width="1.5"/>
  <path d="M 386 26 L 386 14 L 374 14" fill="none" stroke="#e8d8ab" stroke-width="1.5"/>
  <path d="M 14 274 L 14 286 L 26 286" fill="none" stroke="#e8d8ab" stroke-width="1.5"/>
  <path d="M 386 274 L 386 286 L 374 286" fill="none" stroke="#e8d8ab" stroke-width="1.5"/>

  <!-- Geometric Artwork in Center -->
  <g transform="translate(200, 130)" opacity="0.9">
    <circle cx="0" cy="0" r="50" fill="none" stroke="#e8d8ab" stroke-width="1.5" stroke-dasharray="3,3"/>
    <circle cx="0" cy="0" r="38" fill="#1a1813" stroke="#5c5038" stroke-width="1"/>
    <polygon points="0,-35 30,20 -30,20" fill="none" stroke="#e8d8ab" stroke-width="1.5"/>
    <line x1="-45" y1="0" x2="45" y2="0" stroke="#5c5038" stroke-width="1"/>
    <line x1="0" y1="-45" x2="0" y2="45" stroke="#5c5038" stroke-width="1"/>
    <circle cx="0" cy="0" r="4" fill="#e8d8ab"/>
  </g>

  <!-- Typography -->
  <text x="32" y="44" fill="#e8d8ab" font-family="'Courier New', monospace" font-size="10" font-weight="700" letter-spacing="1.5">RESEARCH</text>
  <text x="32" y="240" fill="#f5edd6" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="700" letter-spacing="0.5">RESEARCH 02</text>
  <text x="32" y="260" fill="#e8d8ab" font-family="system-ui, -apple-system, sans-serif" font-size="11" opacity="0.85">Selected Case Study #2</text>
  <text x="368" y="260" text-anchor="end" fill="#5c5038" font-family="'Courier New', monospace" font-size="9">CORBIT // ARCHIVE</text>
</svg>